@model FarmShield.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Reports & Analytics Center";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 no-print">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-file-invoice text-success me-2"></i>Reports, Analytics & Regulatory Exports
        </h2>
        <p class="text-muted m-0">Generate official agricultural compliance exports, mortality rates, and audit archives.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-reportType="@Model.ReportType" asp-route-farmId="@Model.FarmId" asp-route-startDate="@Model.StartDate" asp-route-endDate="@Model.EndDate" class="btn btn-success btn-sm shadow-sm">
            <i class="fa-solid fa-file-csv me-1"></i> Download CSV (Excel)
        </a>
        <button onclick="window.print()" class="btn btn-dark btn-sm shadow-sm">
            <i class="fa-solid fa-print me-1"></i> Print / Save as PDF
        </button>
    </div>
</div>

<!-- Filter Ribbon -->
<div class="card border-0 shadow-sm p-4 mb-4 no-print" style="border-radius: var(--radius-md);">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold">Report Category</label>
            <select name="reportType" class="form-select">
                <option value="compliance" selected="@(Model.ReportType == "compliance")">Biosecurity Audits & Compliance</option>
                <option value="farms" selected="@(Model.ReportType == "farms")">Registered Facilities Master List</option>
                <option value="pigs" selected="@(Model.ReportType == "pigs")">Swine Herd & Weight Records</option>
                <option value="poultry" selected="@(Model.ReportType == "poultry")">Poultry Flocks & Mortality %</option>
                <option value="diseases" selected="@(Model.ReportType == "diseases")">Disease Surveillance Log</option>
                <option value="vaccinations" selected="@(Model.ReportType == "vaccinations")">Immunization Tracking Archive</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label small fw-bold">Filter Facility</label>
            <select name="farmId" class="form-select">
                <option value="">All Facilities</option>
                @foreach (var farm in Model.AvailableFarms)
                {
                    <option value="@farm.FarmId" selected="@(Model.FarmId == farm.FarmId)">@farm.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-bold">From Date</label>
            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-bold">To Date</label>
            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-forest flex-grow-1">Generate</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
    </form>
</div>

<!-- Report Display Container -->
<div class="card border-0 shadow-sm p-4 p-md-5 bg-white mb-5" style="border-radius: var(--radius-md);">
    <!-- Print Header -->
    <div class="border-bottom pb-3 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold m-0 text-success"><i class="fa-solid fa-shield-virus me-2"></i>FARMSHIELD REGULATORY REPORT</h4>
            <div class="text-muted small text-uppercase">Generated: @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm UTC") | Category: @Model.ReportType.ToUpper()</div>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-dark border">Official Record</span>
        </div>
    </div>

    <!-- Active Report Table -->
    @if (Model.ReportType == "farms")
    {
        <h5 class="fw-bold mb-3 text-dark">Registered Agricultural Facilities Directory (@Model.Farms.Count)</h5>
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Owner</th>
                        <th>Type</th>
                        <th>Capacity</th>
                        <th>Area</th>
                        <th>Location</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Farms)
                    {
                        <tr>
                            <td class="fw-bold">@f.FarmCode</td>
                            <td>@f.Name</td>
                            <td>@f.OwnerName</td>
                            <td><span class="badge bg-light text-dark border">@f.FarmType</span></td>
                            <td>@f.TotalCapacity.ToString("N0")</td>
                            <td>@f.FarmAreaAcres ac</td>
                            <td>@f.District, @f.State</td>
                            <td><span class="badge bg-success">@f.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.ReportType == "pigs")
    {
        <h5 class="fw-bold mb-3 text-dark">Swine Livestock Herd Inventory (@Model.Animals.Count)</h5>
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Tag #</th>
                        <th>Facility</th>
                        <th>Breed</th>
                        <th>Category</th>
                        <th>Weight</th>
                        <th>Housing</th>
                        <th>Health</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Animals)
                    {
                        <tr>
                            <td class="fw-bold">@p.TagNumber</td>
                            <td>@p.Farm?.Name</td>
                            <td>@p.Breed</td>
                            <td><span class="badge bg-light text-dark border">@p.Category</span></td>
                            <td>@p.CurrentWeightKg kg</td>
                            <td>@p.PenBarnNumber</td>
                            <td><span class="badge @(p.HealthCondition == FarmShield.Models.Enums.AnimalHealthStatus.Healthy ? "bg-success" : "bg-danger")">@p.HealthCondition</span></td>
                            <td>@p.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.ReportType == "poultry")
    {
        <h5 class="fw-bold mb-3 text-dark">Poultry Batches & Production Parameters (@Model.PoultryBatches.Count)</h5>
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Batch Code</th>
                        <th>Facility</th>
                        <th>Type</th>
                        <th>Breed</th>
                        <th>Initial Count</th>
                        <th>Current Count</th>
                        <th>Mortality</th>
                        <th>Target FCR</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.PoultryBatches)
                    {
                        double mortPct = b.InitialBirdCount > 0 ? Math.Round(((double)b.TotalMortality / b.InitialBirdCount) * 100.0, 2) : 0;
                        <tr>
                            <td class="fw-bold">@b.BatchCode</td>
                            <td>@b.Farm?.Name</td>
                            <td>@b.PoultryType</td>
                            <td>@b.Breed</td>
                            <td>@b.InitialBirdCount.ToString("N0")</td>
                            <td class="fw-bold text-success">@b.CurrentBirdCount.ToString("N0")</td>
                            <td class="text-danger">@b.TotalMortality (@mortPct%)</td>
                            <td>@b.TargetFcr</td>
                            <td><span class="badge bg-success">@b.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.ReportType == "diseases")
    {
        <h5 class="fw-bold mb-3 text-dark">Disease Surveillance & Morbidity Logs (@Model.DiseaseReports.Count)</h5>
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Disease</th>
                        <th>Facility</th>
                        <th>Category</th>
                        <th>Severity</th>
                        <th>Detected</th>
                        <th>Affected</th>
                        <th>Deaths</th>
                        <th>Isolation</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DiseaseReports)
                    {
                        <tr>
                            <td class="fw-bold text-danger">@d.DiseaseName</td>
                            <td>@d.Farm?.Name</td>
                            <td>@d.DiseaseCategory</td>
                            <td><span class="badge bg-danger">@d.Severity</span></td>
                            <td>@d.DetectionDate.ToString("yyyy-MM-dd")</td>
                            <td>@d.AffectedCount</td>
                            <td class="text-danger">@d.MortalityCount</td>
                            <td>@(d.IsolationImplemented ? "Yes" : "No")</td>
                            <td><span class="badge bg-primary">@d.VerificationStatus</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.ReportType == "vaccinations")
    {
        <h5 class="fw-bold mb-3 text-dark">Immunization Records Archive (@Model.Vaccinations.Count)</h5>
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Vaccine</th>
                        <th>Target Disease</th>
                        <th>Facility</th>
                        <th>Batch Lot</th>
                        <th>Date</th>
                        <th>Next Due</th>
                        <th>Route</th>
                        <th>Status</th>
                        <th>Administered By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Vaccinations)
                    {
                        <tr>
                            <td class="fw-bold">@v.VaccineName</td>
                            <td>@v.DiseaseTargeted</td>
                            <td>@v.Farm?.Name</td>
                            <td><span class="badge bg-secondary">@v.BatchLotNumber</span></td>
                            <td>@v.VaccinationDate.ToString("yyyy-MM-dd")</td>
                            <td>@(v.NextDueDate.HasValue ? v.NextDueDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
                            <td>@v.Route</td>
                            <td><span class="badge bg-success">@v.Status</span></td>
                            <td>@v.AdministeredBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <h5 class="fw-bold mb-3 text-dark">Biosecurity Audits & Regulatory Compliance (@Model.Inspections.Count)</h5>
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Facility</th>
                        <th>Audit Date</th>
                        <th>Auditor</th>
                        <th>Compliance Score</th>
                        <th>Risk Level</th>
                        <th>Violations</th>
                        <th>Certified</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ins in Model.Inspections)
                    {
                        <tr>
                            <td class="fw-bold text-success">@ins.InspectionCode</td>
                            <td>@ins.Farm?.Name</td>
                            <td>@ins.InspectionDate.ToString("yyyy-MM-dd")</td>
                            <td>@ins.InspectorName</td>
                            <td><strong class="fs-6 @(ins.CompliancePercentage >= 85 ? "text-success" : "text-warning")">@ins.CompliancePercentage%</strong></td>
                            <td><span class="badge @(ins.RiskLevel == FarmShield.Models.Enums.RiskLevel.Low ? "bg-success" : "bg-danger")">@ins.RiskLevel</span></td>
                            <td>@ins.NonCompliantItems</td>
                            <td>
                                @if (ins.CertifiedBiosecure)
                                {
                                    <span class="badge bg-success">Certified</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

