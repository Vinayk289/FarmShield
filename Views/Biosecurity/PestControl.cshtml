@model List<FarmShield.Models.Entities.PestControlRecord>
@{
    ViewData["Title"] = "Pest & Rodent Surveillance";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-bug-slash text-warning me-2"></i>Pillar E: Integrated Pest & Vector Control (IPM)
        </h2>
        <p class="text-muted m-0">Rodent bait station servicing, snap traps, wild-bird exclusion screens, and fly suppression.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddPestControl" asp-route-farmId="@ViewBag.SelectedFarmId" class="btn btn-forest shadow-sm text-nowrap">
            <i class="fa-solid fa-plus-circle me-1"></i> Log IPM Service
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Hub
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm p-4" style="border-radius: var(--radius-md);">
    <div class="table-responsive">
        <table class="table custom-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Facility</th>
                    <th>Target Vector / Pest</th>
                    <th>Stations Inspected</th>
                    <th>Traps Serviced</th>
                    <th>Infestation Rating</th>
                    <th>Control Chemical / Method</th>
                    <th>Next Due</th>
                    <th>Inspector</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-shield-cat fs-2 mb-2 text-secondary"></i>
                            <div>Zero pest surveillance rounds logged.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><small class="fw-bold">@p.InspectionDate.ToString("yyyy-MM-dd")</small></td>
                            <td><small class="badge bg-light text-dark border">@p.Farm?.Name</small></td>
                            <td class="fw-bold text-dark">@p.TargetPest</td>
                            <td><span class="badge bg-light text-dark border">@p.BaitStationsChecked checked</span></td>
                            <td><span class="badge bg-light text-dark border">@p.TrapsServiced traps</span></td>
                            <td>
                                @if (p.InfestationLevel == "None")
                                {
                                    <span class="badge bg-success">None (Zero Activity)</span>
                                }
                                else if (p.InfestationLevel == "Low")
                                {
                                    <span class="badge bg-info text-white">Low</span>
                                }
                                else if (p.InfestationLevel == "Moderate")
                                {
                                    <span class="badge bg-warning text-dark">Moderate</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Critical / High</span>
                                }
                            </td>
                            <td><small class="text-secondary">@p.ChemicalOrMethodUsed</small></td>
                            <td><small class="text-muted"><i class="fa-solid fa-calendar me-1"></i>@p.NextScheduledDate.ToString("yyyy-MM-dd")</small></td>
                            <td><small class="text-muted">@p.InspectorName</small></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

