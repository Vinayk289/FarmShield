@model List<FarmShield.Models.Entities.WasteManagementRecord>
@{
    ViewData["Title"] = "Waste & Carcass Containment";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-dumpster-fire text-danger me-2"></i>Pillar F: Waste & Carcass Bio-Containment
        </h2>
        <p class="text-muted m-0">Sanitary carcass incineration, high-temperature thermophilic composting, and slurry lagoon containment.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddWaste" asp-route-farmId="@ViewBag.SelectedFarmId" class="btn btn-forest shadow-sm text-nowrap">
            <i class="fa-solid fa-plus-circle me-1"></i> Log Waste Disposal
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Hub
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm p-4" style="border-radius: var(--radius-md);">
    <div class="table-responsive">
        <table class="table custom-table">
            <thead>
                <tr>
                    <th>Disposal Date</th>
                    <th>Facility</th>
                    <th>Waste Classification</th>
                    <th>Disposal Method</th>
                    <th>Quantity (kg)</th>
                    <th>Thermal / Depth Parameter</th>
                    <th>Sanitation Check</th>
                    <th>Supervisor</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-recycle fs-2 mb-2 text-secondary"></i>
                            <div>Zero waste containment operations logged.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var w in Model)
                    {
                        <tr>
                            <td><small class="fw-bold">@w.DisposalDate.ToString("yyyy-MM-dd")</small></td>
                            <td><small class="badge bg-light text-dark border">@w.Farm?.Name</small></td>
                            <td class="fw-bold text-dark">@w.WasteType</td>
                            <td><span class="badge bg-secondary">@w.DisposalMethod</span></td>
                            <td class="fw-bold">@w.QuantityKg.ToString("N0") kg</td>
                            <td><span class="badge bg-light text-dark border">@w.DisposalDepthOrTemp</span></td>
                            <td>
                                @if (w.SanitationOfDisposalAreaChecked)
                                {
                                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Verified Clean</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td><small class="text-muted">@w.SupervisorName</small></td>
                            <td><small class="text-secondary">@w.Remarks</small></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

