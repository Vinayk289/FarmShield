@model List<FarmShield.Models.Entities.CleaningRecord>
@{
    ViewData["Title"] = "Cleaning & Disinfection Logs";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-pump-soap text-primary me-2"></i>Pillar B: Cleaning & Disinfection Tracking
        </h2>
        <p class="text-muted m-0">Terminal barn washing, chemical virucide dilution checks, vehicle spray bay, and footbaths.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddCleaning" asp-route-farmId="@ViewBag.SelectedFarmId" class="btn btn-forest shadow-sm text-nowrap">
            <i class="fa-solid fa-plus-circle me-1"></i> Log Sanitation Round
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Biosecurity Hub
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm p-4" style="border-radius: var(--radius-md);">
    <div class="table-responsive">
        <table class="table custom-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Facility</th>
                    <th>Area Sanitized</th>
                    <th>Equipment Treated</th>
                    <th>Disinfectant Chemical</th>
                    <th>Dilution</th>
                    <th>Stations Verified</th>
                    <th>Staff</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-broom fs-2 mb-2 text-secondary"></i>
                            <div>Zero cleaning records logged.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cln in Model)
                    {
                        <tr>
                            <td><small class="fw-bold">@cln.CleaningDate.ToString("yyyy-MM-dd")</small></td>
                            <td><small class="badge bg-light text-dark border">@cln.Farm?.Name</small></td>
                            <td class="fw-bold text-dark">@cln.FacilityArea</td>
                            <td><small>@cln.EquipmentSanitized</small></td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">@cln.DisinfectantUsed</span></td>
                            <td><span class="badge bg-light text-dark border">@cln.DilutionRatio</span></td>
                            <td>
                                <div class="d-flex gap-1 small" style="font-size: 0.72rem;">
                                    <span class="text-success"><i class="fa-solid fa-check me-1"></i>Footbath</span>
                                    <span class="text-success"><i class="fa-solid fa-check me-1"></i>Wash Arch</span>
                                </div>
                            </td>
                            <td><small class="text-muted">@cln.PerformedBy</small></td>
                            <td><span class="badge bg-success">@cln.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

