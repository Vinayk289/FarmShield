@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Digital Biosecurity & Farm Management Portal";
}

<!-- Hero Section -->
<section class="hero-section" id="overview">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-badge">
                    <i class="fa-solid fa-shield-virus"></i> Enterprise Agricultural Bio-Defense
                </div>
                <h1 class="display-4 fw-extrabold text-white mb-3" style="line-height: 1.15;">
                    Smarter Farming.<br />
                    Safer Livestock.<br />
                    <span class="text-success-emphasis" style="color: #6ee7b7 !important;">Stronger Biosecurity.</span>
                </h1>
                <p class="lead text-white-50 mb-4" style="font-size: 1.18rem; max-width: 600px;">
                    FarmShield is an enterprise-grade digital farm management and biosecurity platform engineered specifically for modern pig and poultry operations. Defend your herds against catastrophic pathogens with automated compliance audits, gate controls, and real-time disease surveillance.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-lg px-4 py-3 fw-bold shadow-lg" style="background-color: #208b59; border-color: #208b59;">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Get Started Free
                    </a>
                    <a href="#biosecurity" class="btn btn-outline-light btn-lg px-4 py-3 fw-bold">
                        <i class="fa-solid fa-circle-play me-2"></i> Explore Biosecurity Pillars
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="card border-0 shadow-lg text-dark p-4" style="border-radius: var(--radius-lg); background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-circle-check text-success fs-4"></i>
                            <h6 class="m-0 fw-bold">Live Biosecurity Shield Status</h6>
                        </div>
                        <span class="badge bg-success">Active Surveillance</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Average Compliance</small>
                                <div class="fs-3 fw-bold text-success">@ViewBag.AverageCompliance%</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Bio-Audits Logged</small>
                                <div class="fs-3 fw-bold text-dark">@ViewBag.TotalInspections</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded border border-success border-opacity-25 bg-success bg-opacity-10 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-virus-slash text-success"></i>
                            <div class="small fw-semibold text-dark">Zero Pathogen Contamination Flagged in Past 48 Hours</div>
                        </div>
                    </div>

                    <div class="text-center">
                        <small class="text-muted">Instant access demo accounts available for evaluation:</small>
                        <div class="mt-2 d-flex justify-content-center gap-2 flex-wrap">
                            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="admin" class="btn btn-sm btn-outline-dark">Admin</a>
                            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="owner" class="btn btn-sm btn-outline-success">Owner</a>
                            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="manager" class="btn btn-sm btn-outline-warning">Manager</a>
                            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="vet" class="btn btn-sm btn-outline-info">Vet Officer</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Live Statistics Section (Data driven from DB) -->
<section class="py-5 bg-light border-bottom" id="statistics">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded shadow-sm border">
                    <div class="stat-icon green mx-auto mb-2"><i class="fa-solid fa-tractor"></i></div>
                    <div class="display-6 fw-bold text-dark">@ViewBag.TotalFarms</div>
                    <div class="text-muted fw-semibold small text-uppercase">Registered Facilities</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded shadow-sm border">
                    <div class="stat-icon orange mx-auto mb-2"><i class="fa-solid fa-piggy-bank"></i></div>
                    <div class="display-6 fw-bold text-dark">@ViewBag.TotalPigs</div>
                    <div class="text-muted fw-semibold small text-uppercase">Pigs Under Monitoring</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded shadow-sm border">
                    <div class="stat-icon blue mx-auto mb-2"><i class="fa-solid fa-feather"></i></div>
                    <div class="display-6 fw-bold text-dark">@ViewBag.TotalBirds.ToString("N0")</div>
                    <div class="text-muted fw-semibold small text-uppercase">Poultry Birds Monitored</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded shadow-sm border">
                    <div class="stat-icon green mx-auto mb-2"><i class="fa-solid fa-clipboard-check"></i></div>
                    <div class="display-6 fw-bold text-dark">@ViewBag.AverageCompliance%</div>
                    <div class="text-muted fw-semibold small text-uppercase">Avg Biosecurity Score</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5" id="features">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 text-uppercase mb-2">Platform Architecture</span>
            <h2 class="fw-bold">Engineered for Agricultural Defense</h2>
            <p class="text-muted mx-auto" style="max-width: 650px;">
                FarmShield combines day-to-day livestock husbandry tracking with veterinary-certified biosecurity inspection matrices to shield producers from preventable epidemiological disasters.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-mobile-screen-button"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Digital Audit Checklists</h5>
                    <p class="text-muted mb-0">
                        Conduct standardized 20-point digital inspections across perimeter fencing, disinfection bays, feed silos, and waste containment with automatic compliance percentage and risk scoring.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Early Outbreak Warnings</h5>
                    <p class="text-muted mb-0">
                        Immediate veterinary escalation for unusual mortalities, respiratory rales, or systemic symptoms with quarantine enforcement, differential diagnosis, and corrective action workflows.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-syringe"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Cold-Chain Immunization</h5>
                    <p class="text-muted mb-0">
                        Complete traceability for swine and poultry vaccine schedules with lot numbers, route tracking, dosage controls, and automated upcoming or overdue booster notifications.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pig Farm Management Showcase -->
