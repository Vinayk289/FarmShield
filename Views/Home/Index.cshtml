                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg overflow-hidden" style="border-radius: var(--radius-lg);">
                    <img src="https://images.unsplash.com/photo-1516467508483-a7212febe31a?auto=format&fit=crop&w=1200&q=80" class="img-fluid" alt="Biosecure Pig Facility" style="height: 380px; object-fit: cover;">
                    <div class="card-body p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold m-0">Specific Pathogen Free (SPF) Swine Standards</h6>
                                <small class="text-muted">Biosecurity Level 3 Filtration & Clean Air Barns</small>
                            </div>
                            <span class="badge bg-success">BioSecure Grade A</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

