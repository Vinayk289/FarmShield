@model FarmShield.ViewModels.FarmListViewModel
@{
    ViewData["Title"] = "Farms Directory";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-tractor text-success me-2"></i>Registered Agricultural Facilities
        </h2>
        <p class="text-muted m-0">Directory of commercial swine, poultry, and integrated multi-species farms.</p>
    </div>
    @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.FarmOwner))
    {
        <a asp-action="Create" class="btn btn-forest shadow-sm text-nowrap">
            <i class="fa-solid fa-plus-circle me-1"></i> Register New Farm
        </a>
    }
</div>

<!-- Search & Filter Controls -->
<div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: var(--radius-md);">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by name, code, district, or owner..." />
            </div>
        </div>

        <div class="col-md-3">
            <select name="filterType" class="form-select">
                <option value="">All Production Types</option>
                <option value="1" selected="@(Model.FilterType == FarmShield.Models.Enums.FarmType.Pig)">Pig Facilities</option>
                <option value="2" selected="@(Model.FilterType == FarmShield.Models.Enums.FarmType.Poultry)">Poultry Facilities</option>
                <option value="3" selected="@(Model.FilterType == FarmShield.Models.Enums.FarmType.Mixed)">Mixed Livestock Facilities</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="filterStatus" class="form-select">
                <option value="">All Facility Statuses</option>
                <option value="1" selected="@(Model.FilterStatus == FarmShield.Models.Enums.FarmStatus.Active)">Active Production</option>
                <option value="2" selected="@(Model.FilterStatus == FarmShield.Models.Enums.FarmStatus.UnderAudit)">Under Biosecurity Audit</option>
                <option value="3" selected="@(Model.FilterStatus == FarmShield.Models.Enums.FarmStatus.Quarantine)">Quarantine Lockdown</option>
                <option value="4" selected="@(Model.FilterStatus == FarmShield.Models.Enums.FarmStatus.Inactive)">Decommissioned / Inactive</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-forest flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
    </form>
</div>

<!-- Farm Cards Grid -->
<div class="row g-4">
    @if (!Model.Farms.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="stat-icon green mx-auto mb-3" style="width: 60px; height: 60px;">
                <i class="fa-solid fa-wheat-awn fs-3"></i>
            </div>
            <h5 class="fw-bold">No facilities matched your search criteria</h5>
            <p class="text-muted">Try resetting search filters or register a new farm.</p>
        </div>
    }
    else
    {
        @foreach (var farm in Model.Farms)
        {
            <div class="col-md-6 col-xl-4">
                <div class="farm-card">
                    <div class="position-relative">
                        <img src="@farm.ImageUrl" class="farm-card-img" alt="@farm.Name" onerror="this.src='https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=800&q=80'" />
                        <span class="position-absolute top-0 start-0 m-3 badge bg-dark bg-opacity-75">
                            @farm.FarmCode
                        </span>
                        <span class="position-absolute top-0 end-0 m-3 badge @(farm.Status == FarmShield.Models.Enums.FarmStatus.Active ? "bg-success" : (farm.Status == FarmShield.Models.Enums.FarmStatus.Quarantine ? "bg-danger" : "bg-warning text-dark"))">
                            @farm.Status
                        </span>
                    </div>

                    <div class="farm-card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold text-uppercase" style="font-size: 0.72rem;">
                                @farm.FarmType Farm
                            </span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.72rem;">
                                @farm.BioSafetyLevel.ToString().Replace("_", " ")
                            </span>
                        </div>

                        <h5 class="fw-bold mb-1">
                            <a asp-action="Details" asp-route-id="@farm.FarmId" class="text-dark text-decoration-none">
                                @farm.Name
                            </a>
                        </h5>
                        <small class="text-muted mb-3 d-block"><i class="fa-solid fa-location-dot me-1 text-danger"></i>@farm.District, @farm.State</small>

                        <div class="row g-2 mb-3 bg-light rounded p-2 text-center small">
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 0.7rem;">CAPACITY</div>
                                <div class="fw-bold text-dark">@farm.TotalCapacity.ToString("N0")</div>
                            </div>
                            <div class="col-4 border-start border-end">
                                <div class="text-muted" style="font-size: 0.7rem;">AREA</div>
                                <div class="fw-bold text-dark">@farm.FarmAreaAcres ac</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size: 0.7rem;">HERD/FLOCK</div>
                                <div class="fw-bold text-success">
                                    @(farm.FarmType == FarmShield.Models.Enums.FarmType.Pig ? farm.Animals.Count(a => a.Status == FarmShield.Models.Enums.AnimalStatus.Active) : farm.PoultryBatches.Where(b => b.Status == FarmShield.Models.Enums.PoultryBatchStatus.Active).Sum(b => b.CurrentBirdCount))
                                </div>
                            </div>
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                            <small class="text-muted">
                                <i class="fa-solid fa-user text-secondary me-1"></i>@farm.OwnerName
                            </small>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@farm.FarmId" class="btn btn-sm btn-forest-outline" title="View Full Profile">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.FarmOwner))
                                {
                                    <a asp-action="Edit" asp-route-id="@farm.FarmId" class="btn btn-sm btn-light border" title="Edit Facility">
                                        <i class="fa-solid fa-pen-to-square text-secondary"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-5 d-flex justify-content-center">
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-filterType="@Model.FilterType" asp-route-filterStatus="@Model.FilterStatus">Previous</a>
            </li>
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-filterType="@Model.FilterType" asp-route-filterStatus="@Model.FilterStatus">@p</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-filterType="@Model.FilterType" asp-route-filterStatus="@Model.FilterStatus">Next</a>
            </li>
        </ul>
    </nav>
}

