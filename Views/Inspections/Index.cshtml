@model FarmShield.ViewModels.InspectionListViewModel
@{
    ViewData["Title"] = "Digital Biosecurity Audits";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-clipboard-check text-success me-2"></i>Digital Biosecurity Inspection System
        </h2>
        <p class="text-muted m-0">Standardized regulatory audits, compliance scoring, and violation corrective tracking.</p>
    </div>
    <a asp-action="Create" asp-route-farmId="@Model.SelectedFarmId" class="btn btn-forest shadow-sm text-nowrap">
        <i class="fa-solid fa-plus-circle me-1"></i> Conduct New Audit
    </a>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card p-3 text-center">
            <small class="text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Audits Conducted</small>
            <div class="fs-2 fw-bold text-dark">@Model.Inspections.Count</div>
            <small class="text-muted">Total Audits</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card p-3 text-center">
            <small class="text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Average Compliance</small>
            <div class="fs-2 fw-bold text-success">@Model.AverageComplianceScore%</div>
            <small class="text-muted">Formula: (C / (Total - NA)) * 100</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card p-3 text-center">
            <small class="text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Certified Facilities</small>
            <div class="fs-2 fw-bold text-primary">@Model.CertifiedFarmsCount</div>
            <small class="text-success fw-semibold"><i class="fa-solid fa-award me-1"></i>Score &gt;= 85%</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card p-3 text-center">
            <small class="text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Auditor Standard</small>
            <div class="fs-4 fw-bold text-secondary mt-1">WOAH / USDA</div>
            <small class="text-muted">20-Point Biosecurity Matrix</small>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: var(--radius-md);">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="farmId" class="form-select">
                <option value="">All Facilities</option>
                @foreach (var farm in Model.AvailableFarms)
                {
                    <option value="@farm.FarmId" selected="@(Model.SelectedFarmId == farm.FarmId)">@farm.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select name="statusFilter" class="form-select">
                <option value="">All Audit Statuses</option>
                <option value="3" selected="@(Model.StatusFilter == FarmShield.Models.Enums.InspectionStatus.Completed)">Completed</option>
                <option value="1" selected="@(Model.StatusFilter == FarmShield.Models.Enums.InspectionStatus.Scheduled)">Scheduled / Pending</option>
                <option value="4" selected="@(Model.StatusFilter == FarmShield.Models.Enums.InspectionStatus.FollowUpRequired)">Follow-Up Required</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="riskFilter" class="form-select">
                <option value="">All Risk Ratings</option>
                <option value="1" selected="@(Model.RiskFilter == FarmShield.Models.Enums.RiskLevel.Low)">Low Risk (>= 85%)</option>
                <option value="2" selected="@(Model.RiskFilter == FarmShield.Models.Enums.RiskLevel.Medium)">Medium Risk (70-84%)</option>
                <option value="3" selected="@(Model.RiskFilter == FarmShield.Models.Enums.RiskLevel.High)">High Risk (&lt; 70%)</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-forest flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
    </form>
</div>

<!-- Audits Table -->
<div class="card border-0 shadow-sm overflow-hidden" style="border-radius: var(--radius-md);">
    <div class="table-responsive">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Inspection Code</th>
                    <th>Facility</th>
                    <th>Date</th>
                    <th>Veterinary Auditor</th>
                    <th>Compliant / Items</th>
                    <th>Compliance %</th>
                    <th>Risk Rating</th>
                    <th>Certification</th>
                    <th class="text-end">Official Report</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Inspections.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-clipboard-check fs-2 mb-2 text-secondary"></i>
                            <div>Zero biosecurity audits recorded.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ins in Model.Inspections)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@ins.InspectionId" class="fw-bold text-success text-decoration-none">
                                    @ins.InspectionCode
                                </a>
                            </td>
                            <td><small class="badge bg-light text-dark border">@ins.Farm?.Name</small></td>
                            <td><small class="fw-bold">@ins.InspectionDate.ToString("yyyy-MM-dd")</small></td>
                            <td>
                                <div class="fw-semibold small text-dark">@ins.InspectorName</div>
                                <small class="text-muted" style="font-size: 0.75rem;">@ins.InspectorDesignation</small>
                            </td>
                            <td>
                                <small class="fw-bold">@ins.CompliantItems / @(ins.TotalChecklistItems - ins.NotApplicableItems)</small>
                                <small class="text-muted">(@ins.NonCompliantItems violations)</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="fw-bold @(ins.CompliancePercentage >= 85 ? "text-success" : (ins.CompliancePercentage >= 70 ? "text-warning" : "text-danger"))">
                                        @ins.CompliancePercentage%
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(ins.RiskLevel == FarmShield.Models.Enums.RiskLevel.Low ? "bg-success" : (ins.RiskLevel == FarmShield.Models.Enums.RiskLevel.Medium ? "bg-warning text-dark" : "bg-danger"))">
                                    @ins.RiskLevel Risk
                                </span>
                            </td>
                            <td>
                                @if (ins.CertifiedBiosecure)
                                {
                                    <span class="badge bg-success"><i class="fa-solid fa-award me-1"></i> Certified</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Action Required</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@ins.InspectionId" class="btn btn-sm btn-outline-dark">
                                    <i class="fa-solid fa-file-pdf me-1"></i> Audit Sheet
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

