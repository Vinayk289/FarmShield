@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <div class="stat-icon red mx-auto mb-3" style="width: 70px; height: 70px; font-size: 32px;">
        <i class="fa-solid fa-lock"></i>
    </div>
    <h2 class="fw-bold text-danger mb-2">Restricted Biosecurity Access Area</h2>
    <p class="text-muted mx-auto" style="max-width: 500px;">
        Your current account role does not have authorization permissions for this confidential farm administrative module.
    </p>
    <div class="mt-4">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-forest me-2">Return to Dashboard</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Sign In with Other Role</a>
    </div>
</div>

