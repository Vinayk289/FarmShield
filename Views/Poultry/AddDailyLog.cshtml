@model FarmShield.ViewModels.DailyLogCreateViewModel
@{
    ViewData["Title"] = $"Add Daily Log: {Model.Batch.BatchCode}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="fa-solid fa-clipboard-list text-success me-2"></i>Daily Flock Log</h3>
                <p class="text-muted small m-0">Batch: <strong>@Model.Batch.BatchCode</strong> (@Model.Batch.BatchName)</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.BatchId" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Batch
            </a>
        </div>

        <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: var(--radius-md);">
            <form asp-action="AddDailyLog" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BatchId" />

                <div class="mb-3">
                    <label asp-for="LogDate" class="form-label"></label>
                    <input asp-for="LogDate" class="form-control" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="MortalityCount" class="form-label"></label>
                        <input asp-for="MortalityCount" class="form-control text-danger fw-bold" />
                        <span asp-validation-for="MortalityCount" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AverageWeightGrams" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="AverageWeightGrams" class="form-control" />
                            <span class="input-group-text">grams</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FeedConsumedKg" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="FeedConsumedKg" class="form-control" />
                            <span class="input-group-text">kg</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="WaterConsumedLiters" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="WaterConsumedLiters" class="form-control" />
                            <span class="input-group-text">Liters</span>
                        </div>
                    </div>
                </div>

                @if (Model.Batch.PoultryType == FarmShield.Models.Enums.PoultryType.Layer)
                {
                    <div class="p-3 mb-3 rounded bg-warning bg-opacity-10 border border-warning border-opacity-25">
                        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-egg text-warning me-1"></i>Layer Egg Production</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="EggsCollected" class="form-label"></label>
                                <input asp-for="EggsCollected" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DamagedEggs" class="form-label"></label>
                                <input asp-for="DamagedEggs" class="form-control" />
                            </div>
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Flock behavior, ventilation remarks, water acidifier dosage..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.BatchId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-forest px-4">
                        <i class="fa-solid fa-save me-1"></i> Save Daily Log
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

